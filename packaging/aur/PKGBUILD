# Maintainer: samoaste <https://github.com/samoaste>
# AUR package "arvudoro-bin": repackages the GitHub release tarball.
# Update pkgver + sha256sums on each release (updpkgsums), then
# makepkg --printsrcinfo > .SRCINFO and push to aur.archlinux.org.
pkgname=arvudoro-bin
pkgver=0.1.1
pkgrel=1
pkgdesc='Pomodoro timer with active breaks: compound exercises with animated demos'
arch=('x86_64' 'aarch64')
url='https://github.com/samoaste/arvudoro'
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'libpipewire')
provides=('arvudoro')
conflicts=('arvudoro')
_raw="https://raw.githubusercontent.com/samoaste/arvudoro/v$pkgver/packaging/linux"
source=("$_raw/com.arvucore.arvudoro.desktop" "$_raw/com.arvucore.arvudoro.png")
sha256sums=('SKIP' 'SKIP')
source_x86_64=("$url/releases/download/v$pkgver/arvudoro-$pkgver-linux-x86_64.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/arvudoro-$pkgver-linux-arm64.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  install -d "$pkgdir/opt/arvudoro" "$pkgdir/usr/bin"
  cp -a arvudoro/. "$pkgdir/opt/arvudoro/"
  ln -s /opt/arvudoro/arvudoro "$pkgdir/usr/bin/arvudoro"
  # same .desktop name the app self-registers, so its user entry shadows
  # this one instead of adding a second menu item
  install -Dm644 com.arvucore.arvudoro.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 com.arvucore.arvudoro.png -t "$pkgdir/usr/share/icons/hicolor/512x512/apps/"
}
